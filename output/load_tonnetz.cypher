MATCH (a:Pitch {pc: 4}), (b:Pitch {pc: 9}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 5}), (b:Pitch {pc: 9}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
