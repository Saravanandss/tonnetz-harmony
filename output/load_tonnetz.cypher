MATCH (a:Pitch {pc: 4}), (b:Pitch {pc: 11}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 4}), (b:Pitch {pc: 8}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
