MATCH (a:Pitch {pc: 6}), (b:Pitch {pc: 11}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 7}), (b:Pitch {pc: 11}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
MATCH (a:Pitch {pc: 7}), (b:Pitch {pc: 10}) MERGE (a)-[:INTERVAL {type: 'm3'}]->(b);
MATCH (a:Pitch {pc: 8}), (b:Pitch {pc: 11}) MERGE (a)-[:INTERVAL {type: 'm3'}]->(b);

// G2 : chord graph (triads joined by P / L / R)
MERGE (:Triad {name: 'C', root: 0, quality: 'maj', notes: [0, 4, 7]});
MERGE (:Triad {name: 'Cm', root: 0, quality: 'min', notes: [0, 3, 7]});
MERGE (:Triad {name: 'C#', root: 1, quality: 'maj', notes: [1, 5, 8]});
MERGE (:Triad {name: 'C#m', root: 1, quality: 'min', notes: [1, 4, 8]});
MERGE (:Triad {name: 'D', root: 2, quality: 'maj', notes: [2, 6, 9]});
MERGE (:Triad {name: 'Dm', root: 2, quality: 'min', notes: [2, 5, 9]});
MERGE (:Triad {name: 'Eb', root: 3, quality: 'maj', notes: [3, 7, 10]});
MERGE (:Triad {name: 'Ebm', root: 3, quality: 'min', notes: [3, 6, 10]});
MERGE (:Triad {name: 'E', root: 4, quality: 'maj', notes: [4, 8, 11]});
MERGE (:Triad {name: 'Em', root: 4, quality: 'min', notes: [4, 7, 11]});
MERGE (:Triad {name: 'F', root: 5, quality: 'maj', notes: [0, 5, 9]});
MERGE (:Triad {name: 'Fm', root: 5, quality: 'min', notes: [0, 5, 8]});
MERGE (:Triad {name: 'F#', root: 6, quality: 'maj', notes: [1, 6, 10]});
MERGE (:Triad {name: 'F#m', root: 6, quality: 'min', notes: [1, 6, 9]});
MERGE (:Triad {name: 'G', root: 7, quality: 'maj', notes: [2, 7, 11]});
MERGE (:Triad {name: 'Gm', root: 7, quality: 'min', notes: [2, 7, 10]});
MERGE (:Triad {name: 'Ab', root: 8, quality: 'maj', notes: [0, 3, 8]});
MERGE (:Triad {name: 'Abm', root: 8, quality: 'min', notes: [3, 8, 11]});
MERGE (:Triad {name: 'A', root: 9, quality: 'maj', notes: [1, 4, 9]});
MERGE (:Triad {name: 'Am', root: 9, quality: 'min', notes: [0, 4, 9]});
MERGE (:Triad {name: 'Bb', root: 10, quality: 'maj', notes: [2, 5, 10]});
MERGE (:Triad {name: 'Bbm', root: 10, quality: 'min', notes: [1, 5, 10]});
MERGE (:Triad {name: 'B', root: 11, quality: 'maj', notes: [3, 6, 11]});
MERGE (:Triad {name: 'Bm', root: 11, quality: 'min', notes: [2, 6, 11]});
MATCH (t:Triad {name: 'C'}), (p:Pitch {pc: 0}) MERGE (t)-[:HAS_NOTE]->(p);
MATCH (t:Triad {name: 'C'}), (p:Pitch {pc: 4}) MERGE (t)-[:HAS_NOTE]->(p);
MATCH (t:Triad {name: 'C'}), (p:Pitch {pc: 7}) MERGE (t)-[:HAS_NOTE]->(p);
