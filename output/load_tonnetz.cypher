// Tonnetz project - load script for Neo4j
// Run in Neo4j Browser or with cypher-shell.

CREATE CONSTRAINT pitch_pc IF NOT EXISTS FOR (p:Pitch) REQUIRE p.pc IS UNIQUE;
CREATE CONSTRAINT triad_name IF NOT EXISTS FOR (t:Triad) REQUIRE t.name IS UNIQUE;

// G1 : pitch-class Tonnetz
MERGE (:Pitch {pc: 0, name: 'C'});
MERGE (:Pitch {pc: 1, name: 'C#'});
MERGE (:Pitch {pc: 2, name: 'D'});
MERGE (:Pitch {pc: 3, name: 'Eb'});
MERGE (:Pitch {pc: 4, name: 'E'});
MERGE (:Pitch {pc: 5, name: 'F'});
MERGE (:Pitch {pc: 6, name: 'F#'});
MERGE (:Pitch {pc: 7, name: 'G'});
MERGE (:Pitch {pc: 8, name: 'Ab'});
MERGE (:Pitch {pc: 9, name: 'A'});
MERGE (:Pitch {pc: 10, name: 'Bb'});
MERGE (:Pitch {pc: 11, name: 'B'});
MATCH (a:Pitch {pc: 0}), (b:Pitch {pc: 7}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 0}), (b:Pitch {pc: 4}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
MATCH (a:Pitch {pc: 0}), (b:Pitch {pc: 3}) MERGE (a)-[:INTERVAL {type: 'm3'}]->(b);
MATCH (a:Pitch {pc: 0}), (b:Pitch {pc: 5}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 0}), (b:Pitch {pc: 8}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
MATCH (a:Pitch {pc: 0}), (b:Pitch {pc: 9}) MERGE (a)-[:INTERVAL {type: 'm3'}]->(b);
MATCH (a:Pitch {pc: 1}), (b:Pitch {pc: 8}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 1}), (b:Pitch {pc: 5}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
MATCH (a:Pitch {pc: 1}), (b:Pitch {pc: 4}) MERGE (a)-[:INTERVAL {type: 'm3'}]->(b);
MATCH (a:Pitch {pc: 1}), (b:Pitch {pc: 6}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 1}), (b:Pitch {pc: 9}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
MATCH (a:Pitch {pc: 1}), (b:Pitch {pc: 10}) MERGE (a)-[:INTERVAL {type: 'm3'}]->(b);
MATCH (a:Pitch {pc: 2}), (b:Pitch {pc: 9}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 2}), (b:Pitch {pc: 6}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
MATCH (a:Pitch {pc: 2}), (b:Pitch {pc: 5}) MERGE (a)-[:INTERVAL {type: 'm3'}]->(b);
MATCH (a:Pitch {pc: 2}), (b:Pitch {pc: 7}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 2}), (b:Pitch {pc: 10}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
MATCH (a:Pitch {pc: 2}), (b:Pitch {pc: 11}) MERGE (a)-[:INTERVAL {type: 'm3'}]->(b);
MATCH (a:Pitch {pc: 3}), (b:Pitch {pc: 10}) MERGE (a)-[:INTERVAL {type: 'P5'}]->(b);
MATCH (a:Pitch {pc: 3}), (b:Pitch {pc: 7}) MERGE (a)-[:INTERVAL {type: 'M3'}]->(b);
